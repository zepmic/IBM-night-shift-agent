# Kopieren nach .env und echte Werte eintragen (.env wird nicht committet)
# Namen an das Starter Kit anpassen, sobald bekannt.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Preise pro 1M Tokens (eigene Kostenschätzung im Runner)
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.40

# Jev 1.14 (TypeSafe AI) – Doku kommt beim Opening
JEV_BASE_URL=
JEV_API_KEY=
JEV_MODEL=jev-1.14

# MOCK=1 -> offline mit Fake-Modell testen
MOCK=0

# Lokal testen mit Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=granite3.3:2b  LLM_API_KEY=ollama
